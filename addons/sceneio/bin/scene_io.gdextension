[configuration]

entry_symbol = "scene_io_plugin_init"
compatibility_minimum = "4.1"

[libraries]
; Relative paths ensure that our GDExtension can be placed anywhere in the project directory.
macos.debug = "res://addons/sceneio/addons/sceneio/bin/libsceneio.macos.template_debug.dylib"
macos.editor = "res://addons/sceneio/bin/libsceneio.macos.editor.dylib"

windows.x86_64.debug = "res://addons/sceneio/bin/libsceneio.windows.template_debug.x86_64.dll"
windows.x86_64.editor = "res://addons/sceneio/bin/libsceneio.windows.editor.x86_64.dll"

linux.x86_64.debug = "res://addons/sceneio/bin/libsceneio.linux.template_debug.x86_64.so"
linux.x86_64.editor = "res://addons/sceneio/bin/libsceneio.linux.editor.x86_64.so"

linux.arm64.debug = "res://addons/sceneio/bin/libsceneio.linux.template_debug.arm64.so"
linux.arm64.editor = "res://addons/sceneio/bin/libsceneio.linux.editor.arm64.so"