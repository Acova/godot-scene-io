[configuration]

entry_symbol = "scene_io_plugin_init"
compatibility_minimum = "4.1"

[libraries]
; Relative paths ensure that our GDExtension can be placed anywhere in the project directory.
macos.single.debug = "res://addons/sceneio/addons/sceneio/bin/libsceneio.macos.template_debug.dylib"
macos.double.debug = "res://addons/sceneio/bin/libsceneio.macos.template_debug.double.dylib"
macos.single.editor = "res://addons/sceneio/bin/libsceneio.macos.editor.dylib"
macos.double.editor = "res://addons/sceneio/bin/libsceneio.macos.editor.double.dylib"

ios.arm64.single.debug = "res://addons/sceneio/bin/libsceneio.ios.template_debug.arm64.dylib"
ios.arm64.double.debug = "res://addons/sceneio/bin/libsceneio.ios.template_debug.arm64.double.dylib"
ios.arm64.single.editor = "res://addons/sceneio/bin/libsceneio.ios.editor.arm64.dylib"
ios.arm64.double.editor = "res://addons/sceneio/bin/libsceneio.ios.editor.arm64.double.dylib"

windows.x86_32.single.debug = "res://addons/sceneio/bin/libsceneio.windows.template_debug.x86_32.dll"
windows.x86_32.double.debug = "res://addons/sceneio/bin/libsceneio.windows.template_debug.x86_32.double.dll"
windows.x86_32.single.editor = "res://addons/sceneio/bin/libsceneio.windows.editor.x86_32.dll"
windows.x86_32.double.editor = "res://addons/sceneio/bin/libsceneio.windows.editor.x86_32.double.dll"

windows.x86_64.single.debug = "res://addons/sceneio/bin/libsceneio.windows.template_debug.x86_64.dll"
windows.x86_64.double.debug = "res://addons/sceneio/bin/libsceneio.windows.template_debug.x86_64.double.dll"
windows.x86_64.single.editor = "res://addons/sceneio/bin/libsceneio.windows.editor.x86_64.dll"
windows.x86_64.double.editor = "res://addons/sceneio/bin/libsceneio.windows.editor.x86_64.double.dll"

linux.x86_64.single.debug = "res://addons/sceneio/bin/libsceneio.linux.template_debug.x86_64.so"
linux.x86_64.double.debug = "res://addons/sceneio/bin/libsceneio.linux.template_debug.x86_64.double.so"
linux.x86_64.single.editor = "res://addons/sceneio/bin/libsceneio.linux.editor.x86_64.so"
linux.x86_64.double.editor = "res://addons/sceneio/bin/libsceneio.linux.editor.x86_64.double.so"

linux.arm64.single.debug = "res://addons/sceneio/bin/libsceneio.linux.template_debug.arm64.so"
linux.arm64.double.debug = "res://addons/sceneio/bin/libsceneio.linux.template_debug.arm64.double.so"
linux.arm64.single.editor = "res://addons/sceneio/bin/libsceneio.linux.editor.arm64.so"
linux.arm64.double.editor = "res://addons/sceneio/bin/libsceneio.linux.editor.arm64.double.so"

linux.rv64.single.debug = "res://addons/sceneio/bin/libsceneio.linux.template_debug.rv64.so"
linux.rv64.double.debug = "res://addons/sceneio/bin/libsceneio.linux.template_debug.rv64.double.so"
linux.rv64.single.editor = "res://addons/sceneio/bin/libsceneio.linux.editor.rv64.so"
linux.rv64.double.editor = "res://addons/sceneio/bin/libsceneio.linux.editor.rv64.double.so"

android.x86_64.single.debug = "res://addons/sceneio/bin/libsceneio.android.template_debug.x86_64.so"
android.x86_64.double.debug = "res://addons/sceneio/bin/libsceneio.android.template_debug.x86_64.double.so"
android.x86_64.single.editor = "res://addons/sceneio/bin/libsceneio.android.editor.x86_64.so"
android.x86_64.double.editor = "res://addons/sceneio/bin/libsceneio.android.editor.x86_64.double.so"

android.arm64.single.debug = "res://addons/sceneio/bin/libsceneio.android.template_debug.arm64.so"
android.arm64.double.debug = "res://addons/sceneio/bin/libsceneio.android.template_debug.arm64.double.so"
android.arm64.single.editor = "res://addons/sceneio/bin/libsceneio.android.editor.arm64.so"
android.arm64.double.editor = "res://addons/sceneio/bin/libsceneio.android.editor.arm64.double.so"

web.wasm32.single.debug = "res://addons/sceneio/bin/libsceneio.web.template_debug.wasm32.nothreads.wasm"
web.wasm32.double.debug = "res://addons/sceneio/bin/libsceneio.web.template_debug.wasm32.double.nothreads.wasm"
web.wasm32.single.editor = "res://addons/sceneio/bin/libsceneio.web.editor.wasm32.nothreads.wasm"
web.wasm32.double.editor = "res://addons/sceneio/bin/libsceneio.web.editor.wasm32.double.nothreads.wasm"